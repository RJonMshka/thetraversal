{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["TARGET_*_ORIGIN"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@tv/ir#build": {
      "inputs": ["src/**", "package.json", "../../content/**"],
      "outputs": ["dist/**", "../../apps/shell/public/ir/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "conformance": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#parity": {
      "dependsOn": ["@tv/shell#build", "@tv/target-ast#build"],
      "cache": false
    }
  }
}
