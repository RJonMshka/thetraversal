{
  "name": "thetraversal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "conformance": "turbo run conformance",
    "e2e": "turbo run //#parity",
    "parity": "playwright test",
    "e2e:update": "turbo run build --filter=@tv/shell --filter=@tv/target-ast && playwright test --update-snapshots",
    "measure:first-load": "node scripts/measure-first-load.mjs apps/shell/.next"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "turbo": "^2.11.10"
  }
}
