{
  "extends": "@tv/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    // content/ (@tv/content) has no dependencies of its own, so its
    // type-only `@tv/ir` imports resolve to this package's source here.
    "paths": {
      "@tv/ir": ["./src/index.ts"],
      "@tv/ir/compiler": ["./src/compiler/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../content/registry/**/*.ts"]
}
